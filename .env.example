# ==============================================================================
# Multi-Source Network Event & Incident Analysis Platform - Environment Config
# ==============================================================================

# Web & Frontend Port
PORT=8089

# Django Core Settings
DJANGO_SECRET_KEY=eventanalyzer-super-secret-key-2026-production-ready
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
POSTGRES_DB=eventanalyzer_db
POSTGRES_USER=eventanalyzer_user
POSTGRES_PASSWORD=eventanalyzer_secure_pass_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Business Rule Thresholds
ROUTER_REBOOT_THRESHOLD_SECONDS=3600
REBOOT_TIME_TOLERANCE_SECONDS=300

# SNMP Verification Settings
SNMP_COMMUNITY=public
SNMP_VERIFY_MAX_RETRIES=3
SNMP_VERIFY_RETRY_DELAY=30
DEFAULT_SNMP_TIMEOUT=5

# PRTG Integration Security
PRTG_ENABLED=True
PRTG_API_TOKEN=prtg-secure-webhook-token-2026

# General Timezone
TZ=Asia/Bangkok
TIME_ZONE=Asia/Bangkok
